# Copy to .env and adjust. Variables already set in the environment take precedence.
# Full reference: docs/CONFIGURATION.md

# --- HTTP server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Number of reverse proxies in front of the service whose X-Forwarded-For you trust (0 = none).
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API (empty = CORS disabled).
CORS_ORIGINS=

# --- Authentication (required) -------------------------------------------------
# Generate with: npm run keygen
# Preferred: store only SHA-256 digests ("label:hexdigest").
API_KEY_HASHES=
# Alternative: plain keys ("label:key", min. 16 chars).
API_KEYS=
# AUTH_DISABLED=true   # local development only, never in production

# --- Rate limiting (per API key) ----------------------------------------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
AUTH_FAILURES_PER_MINUTE=10

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=info
# full | host | none — how much of submitted/destination URLs appears in logs.
LOG_URLS=host

# --- Capacity & queue ----------------------------------------------------------
# Each job uses one browser context (~50–150 MB). Size to your CPU/RAM.
MAX_CONCURRENT_JOBS=4
MAX_QUEUE_SIZE=100
QUEUE_TIMEOUT_MS=60000

# --- Agent behaviour -------------------------------------------------------------
JOB_TIMEOUT_MS=150000
NAVIGATION_TIMEOUT_MS=30000
MAX_STEPS=30
# Total time a job may spend waiting for countdowns / disabled buttons.
MAX_COUNTDOWN_WAIT_MS=90000
MAX_CHAIN_DEPTH=2

# --- Browser ---------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_SANDBOX=false
BROWSER_RECYCLE_AFTER_JOBS=100
BLOCK_RESOURCE_TYPES=media,font
BLOCK_AD_DOMAINS=false
# USER_AGENT=

# --- Network policy (SSRF protection) -------------------------------------------
ALLOWED_PORTS=80,443
# DANGEROUS: exempts ranges from the private-network block. Leave empty in production.
ALLOW_PRIVATE_NETWORK_CIDRS=
DOMAIN_DENYLIST=
DESTINATION_DENYLIST=

# --- Shorteners ------------------------------------------------------------------
# Additional AdLinkFly-based shortener domains (comma-separated).
ADLINKFLY_EXTRA_DOMAINS=
# Let the generic agent try any host (not recommended for public deployments).
ALLOW_UNLISTED_SHORTENERS=false

# --- Destination extraction ------------------------------------------------------
FOLLOW_TRACKING_REDIRECTS=true
STRIP_TRACKING_PARAMS=true

# --- Result cache ------------------------------------------------------------------
RESULT_CACHE_TTL_MS=600000

# --- Optional AI fallback ----------------------------------------------------------
# none | openai (any OpenAI-compatible endpoint) | anthropic
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
AI_MAX_CALLS_PER_JOB=4

# --- Optional CAPTCHA solver -------------------------------------------------------
# Off by default: the agent reports CAPTCHAs (HUMAN_VERIFICATION_REQUIRED) instead of solving them.
# Enabling this may conflict with the target sites' / providers' terms of service — use only where
# you are authorised. none | 2captcha | capsolver
CAPTCHA_PROVIDER=none
# CAPTCHA_API_KEY=
# CAPTCHA_BASE_URL=https://api.2captcha.com
# CAPTCHA_TIMEOUT_MS=120000
# Must be > 0 to enable the solver.
CAPTCHA_MAX_SOLVES_PER_JOB=0

# --- Metrics -------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=true
